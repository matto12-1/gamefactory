":["어리니"],"tip":"어린 사람이라서 어린이예요","boss":{"sentence":"어린이들이 손을 잡고 걸어요.","other":"손"}},{"right":"할아버지","wrong":["하라버지"],"tip":"할아버지 안에 아버지가 있어요","boss":{"sentence":"할아버지가 옛날이야기를 해요.","other":"옛날이야기"}},{"right":"꽃밭","wrong":["꽃밧"],"tip":"꽃이 자라는 밭이라서 꽃밭이에요","boss":{"sentence":"꽃밭에 나비가 날아왔어요.","other":"나비"}},{"right":"햇빛","wrong":["햇빗"],"tip":"해의 빛이라서 햇빛이에요","boss":{"sentence":"창문으로 햇빛이 들어와요.","other":"창문"}},{"right":"깡충깡충","wrong":["깡총깡총"],"tip":"깡충깡충이 바른 말이에요","boss":{"sentence":"토끼가 깡충깡충 뛰어요.","other":"토끼"}},{"right":"유월","wrong":["육월"],"tip":"6월은 유월이라고 써요","boss":{"sentence":"유월에는 날씨가 더워져요.","other":"날씨"}},{"right":"시월","wrong":["십월"],"tip":"10월은 시월이라고 써요","boss":{"sentence":"시월에 가을 소풍을 가요.","other":"소풍"}},{"right":"쌍둥이","wrong":["쌍동이"],"tip":"귀염둥이, 막둥이처럼 둥이로 끝나요","boss":{"sentence":"우리 반에는 쌍둥이가 있어요.","other":"반"}},{"right":"냄비","wrong":["남비"],"tip":"냄비가 바른 말이에요","boss":{"sentence":"냄비에 물을 끓여요.","other":"물"}},{"right":"촛불","wrong":["초불"],"tip":"초와 불 사이에 ㅅ이 들어가요","boss":{"sentence":"생일 케이크의 촛불을 꺼요.","other":"케이크"}},{"right":"나뭇잎","wrong":["나무잎"],"tip":"나무와 잎 사이에 ㅅ이 들어가요","boss":{"sentence":"노란 나뭇잎이 바람에 날려요.","other":"바람"}}],"b":[{"right":"돼요","wrong":["되요"],"tip":"되어요를 줄이면 돼요","boss":{"sentence":"내일 가도 돼요.","other":"내일"}},{"right":"안 돼요","wrong":["안 되요"],"tip":"되어요를 줄이면 돼요","boss":{"sentence":"복도에서 뛰면 안 돼요.","other":"복도"}},{"right":"할게요","wrong":["할께요"],"tip":"소리는 께로 나도 게로 써요","boss":{"sentence":"청소는 내가 할게요.","other":"청소"}},{"right":"며칠","wrong":["몇일"],"tip":"며칠이 바른 말이에요","boss":{"sentence":"여행까지 며칠 남았어요.","other":"여행"}},{"right":"금세 사라졌어요","wrong":["금새 사라졌어요"],"tip":"곧바로라는 뜻은 금세예요","boss":{"sentence":"안개가 금세 사라졌어요.","other":"안개"}},{"right":"일부러 그랬어요","wrong":["일부로 그랬어요"],"tip":"마음먹고 하는 것은 일부러예요","boss":{"sentence":"친구를 웃기려고 일부러 그랬어요.","other":"친구"}},{"right":"설거지","wrong":["설겆이"],"tip":"설겆다는 안 쓰는 말이라 설거지예요","boss":{"sentence":"저녁을 먹고 설거지를 했어요.","other":"저녁"}},{"right":"어떡해","wrong":["어떻해"],"tip":"어떻게 해를 줄이면 어떡해예요","boss":{"sentence":"버스를 놓쳤는데 어떡해?","other":"버스"}},{"r